{
	"name": "nellowtcs-blog",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"make-pretty": "prettier --write .",
		"optimize-images": "image-transmutation --run --sourceFolder './build/images' --targetFolder './build/images.optimized' --inputFormats 'jpg' --inputFormats 'jpeg' --inputFormats 'png' --outputFormats 'png' --outputFormats 'webp' --outputFormats 'avif' && mv ./build/images ./build/images.bak && mv ./build/images.optimized ./build/images && rm -rf ./build/images.bak",
		"postbuild": "npm run optimize-images && svelte-sitemap --domain https://nellowtcs.me/"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.2.0",
		"dateformat": "^5.0.3",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"image-transmutation": "^1.1.2",
		"mdsvex": "^0.12.8",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.0.0",
		"rehype-external-links": "^3.0.0",
		"rehype-slug": "^6.0.0",
		"sass": "^1.102.0",
		"striptags": "^3.2.0",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"svelte-sitemap": "^4.0.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1"
	},
	"type": "module",
	"dependencies": {
		"@fontsource/inter": "^5.3.0",
		"@fontsource/merriweather": "^5.3.0",
		"@fontsource/ubuntu-mono": "^5.3.0"
	}
}
